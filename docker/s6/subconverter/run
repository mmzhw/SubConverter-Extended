#!/bin/sh
# 反代场景下默认信任 nginx 一跳，使 dashboard 识别真实客户端 IP；用户显式设置时优先用户值
export SUBCONVERTER_DASHBOARD_CLIENT_IP_HEADER="${SUBCONVERTER_DASHBOARD_CLIENT_IP_HEADER:-x-forwarded-for}"
export SUBCONVERTER_DASHBOARD_TRUSTED_PROXY_CIDRS="${SUBCONVERTER_DASHBOARD_TRUSTED_PROXY_CIDRS:-127.0.0.1/32}"
export SUBCONVERTER_LISTEN_PORT="${SUBCONVERTER_LISTEN_PORT:-25501}"
export SUBCONVERTER_SHORT_LINKS_FILE="${SUBCONVERTER_SHORT_LINKS_FILE:-/base/short-links/links.json}"
mkdir -p "$(dirname "$SUBCONVERTER_SHORT_LINKS_FILE")"

if [ -z "${SUBCONVERTER_SHORT_LINK_PASSWORD:-}" ]; then
  password_file="${SUBCONVERTER_SHORT_LINK_PASSWORD_FILE:-/base/short-links/admin-password}"
  mkdir -p "$(dirname "$password_file")"
  if [ ! -s "$password_file" ]; then
    umask 077
    od -An -N24 -tx1 /dev/urandom | tr -d ' \n' > "$password_file"
    printf '\n' >> "$password_file"
    password_source="generated at $password_file"
  else
    password_source="loaded from $password_file"
  fi
  export SUBCONVERTER_SHORT_LINK_PASSWORD="$(head -n 1 "$password_file")"
else
  password_source="loaded from SUBCONVERTER_SHORT_LINK_PASSWORD"
fi
(
  sleep "${SUBCONVERTER_SHORT_LINK_PASSWORD_LOG_DELAY:-3}"
  echo "Short-link management password source: $password_source"
  echo "Short-link management password: $SUBCONVERTER_SHORT_LINK_PASSWORD"
) &
exec /usr/local/bin/start-subconverter
